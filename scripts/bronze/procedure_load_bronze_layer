/* script purpose :
    this stored procedure to load data into  the bronze layer from the csv files 
    -it truncates the bronze table before loading it 
    - bulk insert to load all the data into the tables 
    usage : exec  bronze.Layer_bronze;
    */
    --inserting data into our table  
--using truncate and insert : truncate to first check that the table is empty  and then inserrt  
-- and by that you will alwayse get fresh data from the file 

--exec  bronze.Layer_bronze;

create or alter  procedure bronze.Layer_bronze as 
