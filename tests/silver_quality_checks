check for crm_sales_details
--=================================
--check for sales_details silver layer 
--check for sls_prd_key
select 
sls_prd_key
from silver.crm_sales_details
where sls_prd_key != trim (sls_prd_key )
--check for sls_ord_num
select 
sls_ord_num
from silver.crm_sales_details
where sls_ord_num != trim (sls_ord_num )
--check for sls_order_dt
-- the date is int so make sure there is no zero or negative
select 
sls_order_dt
from bronze.crm_sales_details
where sls_order_dt < 0 
      or sls_order_dt = 0 
      or len (sls_order_dt) != 8
      or sls_order_dt = 20291012
      or sls_order_dt = 19901203
-- check for the sales and prices 
-- sum of sales should = prices* quantity with no negative values and no zero
select 
sls_sales,
sls_quantity,
sls_price
from silver.crm_sales_details
where sls_sales != sls_quantity*sls_price or sls_sales is null
--prices shoudnt be negative or 0 
--quantity shount be negative too
select 
sls_price
from silver.crm_sales_details
where sls_price is null or sls_price < 0 or sls_price =0
